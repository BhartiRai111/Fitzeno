# Base URL of the NestJS backend API, including its global prefix/version
# (see backend/src/bootstrap.ts — setGlobalPrefix('api') + URI versioning).
# Exposed to the browser (NEXT_PUBLIC_) because the app talks to the API
# directly from client components — never put a secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
