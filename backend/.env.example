# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=3001

# Matches the default docker-compose.yml service. If you're using a native
# Postgres install instead, point this at your own role/database.
DATABASE_URL="postgresql://fitzeno:fitzeno_dev_password@localhost:5432/fitzeno_dev?schema=public"

# Generate a real value with `openssl rand -base64 48` — do not reuse this
# placeholder anywhere outside local development.
JWT_SECRET="dev-only-insecure-secret-change-me-before-any-real-deployment"
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens are DB rows (revocable), not JWTs — this is just their expiry.
JWT_REFRESH_TOKEN_TTL_DAYS=30
# How long a forgot-password / staff-invite link stays valid.
PASSWORD_RESET_TTL_HOURS=2

# Comma-separated list of origins allowed to call this API. The Next.js
# frontend runs on :3000 in development.
CORS_ORIGIN="http://localhost:3000"

# Requests allowed per THROTTLE_TTL_MS window, per client, before a 429.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
